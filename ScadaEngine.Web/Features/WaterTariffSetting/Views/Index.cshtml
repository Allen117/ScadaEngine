@model ScadaEngine.Web.Features.WaterTariffSetting.Models.WaterTariffSettingViewModel
@{
    ViewData["Title"] = Localizer["watertariff.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="fas fa-hand-holding-water text-primary me-2"></i>@Localizer["watertariff.title"]
        </h2>
        <span class="text-muted small">
            <i class="fas fa-leaf me-1"></i>@Localizer["watertariff.breadcrumb.energy"]
        </span>
    </div>

    <!-- 方案版本選擇 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-list-ul me-1"></i>@Localizer["watertariff.select.title"]
        </div>
        <div class="card-body p-3">
            <div class="wt-select-bar">
                <div class="wt-plan-select">
                    <label class="form-label fw-semibold">@Localizer["watertariff.select.plan"]</label>
                    <select id="wtPlan" class="form-select form-select-sm"></select>
                </div>
                <div class="wt-plan-btns">
                    <button class="btn btn-outline-primary btn-sm" onclick="window._wt.addVersion()">
                        <i class="fas fa-copy me-1"></i>@Localizer["watertariff.button.add_version"]
                    </button>
                    <button class="btn btn-outline-danger btn-sm" id="btnWtDelPlan" onclick="window._wt.deletePlan()">
                        <i class="fas fa-trash-alt me-1"></i>@Localizer["watertariff.button.del_plan"]
                    </button>
                </div>
            </div>
            <div class="text-muted small mt-2">
                <i class="fas fa-info-circle me-1"></i>@Localizer["watertariff.hint.effective"]
            </div>
        </div>
    </div>

    <!-- 方案內容（JS 渲染級距編輯表） -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <span><i class="fas fa-edit me-1"></i><span id="wtPlanTitle">@Localizer["watertariff.editor.loading"]</span></span>
            <span class="badge bg-secondary">@Localizer["watertariff.badge.progressive"]</span>
        </div>
        <div class="card-body p-3" id="wtPlanContainer">
            <div class="text-center text-muted py-4">@Localizer["watertariff.editor.loading"]</div>
        </div>
        <div class="card-footer bg-light py-2 d-flex justify-content-between">
            <button class="btn btn-outline-secondary btn-sm" onclick="window._wt.resetSeed()">
                <i class="fas fa-undo me-1"></i>@Localizer["watertariff.button.reset"]
            </button>
            <button class="btn btn-primary btn-sm" onclick="window._wt.saveAll()">
                <i class="fas fa-save me-1"></i>@Localizer["watertariff.button.save"]
            </button>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/watertariffsetting.css" asp-append-version="true" />

@section Scripts {
    <script src="~/js/watertariffsetting.js" asp-append-version="true"></script>
}
