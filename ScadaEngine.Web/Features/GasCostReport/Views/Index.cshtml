@model ScadaEngine.Web.Features.GasCostReport.Models.GasCostReportViewModel
@{
    ViewData["Title"] = Localizer["gascostreport.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="fas fa-fire text-primary me-2"></i>@Localizer["gascostreport.title"]
        </h2>
        <span class="text-muted small">
            <i class="fas fa-leaf me-1"></i>@Localizer["gascostreport.breadcrumb.energy"]
        </span>
    </div>

    <!-- 查詢條件（版型同電費/水費報表，樣式共用 energyreport.css 的 er-* class） -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-filter me-1"></i>@Localizer["gascostreport.filter.title"]
        </div>
        <div class="card-body p-3">
            <div class="er-filter-bar">
                <div class="er-circuit">
                    <label class="form-label fw-semibold"><i class="fas fa-sitemap me-1"></i>@Localizer["gascostreport.filter.circuit"]</label>
                    <select id="gcrCircuit" class="form-select form-select-sm">
                        <option value="">@Localizer["gascostreport.select.loading"]</option>
                    </select>
                </div>
                <div class="er-narrow-date">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["gascostreport.filter.month_start"]</label>
                    <input type="month" id="gcrMonthStart" class="form-control form-control-sm">
                </div>
                <div class="er-narrow-date">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["gascostreport.filter.month_end"]</label>
                    <input type="month" id="gcrMonthEnd" class="form-control form-control-sm">
                </div>
                <div class="er-period-hint">
                    <span id="gcrPeriodHint" class="text-muted small"></span>
                </div>
                <div class="er-btn">
                    <button class="btn btn-primary btn-sm" onclick="window._gcr.query()">
                        <i class="fas fa-search me-1"></i>@Localizer["gascostreport.button.query"]
                    </button>
                </div>
                <div class="er-btn">
                    <button class="btn btn-success btn-sm" onclick="window._gcr.exportExcel()" id="btnGcrExport" disabled>
                        <i class="fas fa-file-excel me-1"></i>@Localizer["gascostreport.button.export"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 結果區 -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-chart-bar me-1"></i>@Localizer["gascostreport.chart.title"]
                </div>
                <div class="card-body">
                    <div style="height:360px;position:relative;">
                        <canvas id="gcrChart"></canvas>
                        <div id="gcrNoData" class="gcr-nodata" style="display:none;"></div>
                    </div>
                </div>
                <div class="card-footer bg-light text-muted small">
                    @Localizer["gascostreport.label.total"]：<span id="gcrTotalCost" class="fw-bold text-primary">--</span> @Localizer["gascostreport.unit.ntd"]
                    <span class="ms-3">@Localizer["gascostreport.label.total_m3"]：<span id="gcrTotalM3" class="fw-bold">--</span> m&#179;</span>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-table me-1"></i>@Localizer["gascostreport.table.title"]
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                        <table class="table table-striped table-hover table-bordered mb-0">
                            <thead class="table-dark" style="position:sticky;top:0;z-index:30;">
                                <tr>
                                    <th>@Localizer["gascostreport.table.col_period"]</th>
                                    <th class="text-end">@Localizer["gascostreport.table.col_m3"]</th>
                                    <th>@Localizer["gascostreport.table.col_plan"]</th>
                                    <th class="text-end">@Localizer["gascostreport.table.col_cost"]</th>
                                    <th class="text-center">@Localizer["gascostreport.table.col_detail"]</th>
                                </tr>
                            </thead>
                            <tbody id="gcrTableBody">
                                <tr><td colspan="5" class="text-center text-muted py-4">@Localizer["gascostreport.table.empty"]</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/energyreport.css" />
<link rel="stylesheet" href="~/css/gascostreport.css" asp-append-version="true" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/gascostreport.js" asp-append-version="true"></script>
    <script>
        window._gcrInit = { today: '@Model.dtToday.ToString("yyyy-MM-dd")' };
    </script>
}
