@model ScadaEngine.Web.Features.GasTariffSetting.Models.GasTariffSettingViewModel
@{
    ViewData["Title"] = Localizer["gastariff.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="fas fa-fire text-primary me-2"></i>@Localizer["gastariff.title"]
        </h2>
        <span class="text-muted small">
            <i class="fas fa-leaf me-1"></i>@Localizer["gastariff.breadcrumb.energy"]
        </span>
    </div>

    <!-- 方案版本選擇 -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-list-ul me-1"></i>@Localizer["gastariff.select.title"]
        </div>
        <div class="card-body p-3">
            <div class="gt-select-bar">
                <div class="gt-plan-select">
                    <label class="form-label fw-semibold">@Localizer["gastariff.select.plan"]</label>
                    <select id="gtPlan" class="form-select form-select-sm"></select>
                </div>
                <div class="gt-plan-btns">
                    <button class="btn btn-outline-primary btn-sm" onclick="window._gt.addVersion()">
                        <i class="fas fa-copy me-1"></i>@Localizer["gastariff.button.add_version"]
                    </button>
                    <button class="btn btn-outline-danger btn-sm" id="btnGtDelPlan" onclick="window._gt.deletePlan()">
                        <i class="fas fa-trash-alt me-1"></i>@Localizer["gastariff.button.del_plan"]
                    </button>
                </div>
            </div>
            <div class="text-muted small mt-2">
                <i class="fas fa-info-circle me-1"></i>@Localizer["gastariff.hint.effective"]
            </div>
            <div class="text-muted small mt-1">
                <i class="fas fa-exclamation-triangle me-1 text-warning"></i>@Localizer["gastariff.hint.period_decoupled"]
            </div>
        </div>
    </div>

    <!-- 方案內容（JS 渲染級距編輯表） -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <span><i class="fas fa-edit me-1"></i><span id="gtPlanTitle">@Localizer["gastariff.editor.loading"]</span></span>
            <span class="badge bg-secondary">@Localizer["gastariff.badge.progressive"]</span>
        </div>
        <div class="card-body p-3" id="gtPlanContainer">
            <div class="text-center text-muted py-4">@Localizer["gastariff.editor.loading"]</div>
        </div>
        <div class="card-footer bg-light py-2 d-flex justify-content-between">
            <button class="btn btn-outline-secondary btn-sm" onclick="window._gt.resetSeed()">
                <i class="fas fa-undo me-1"></i>@Localizer["gastariff.button.reset"]
            </button>
            <button class="btn btn-primary btn-sm" onclick="window._gt.saveAll()">
                <i class="fas fa-save me-1"></i>@Localizer["gastariff.button.save"]
            </button>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/gastariffsetting.css" asp-append-version="true" />

@section Scripts {
    <script src="~/js/gastariffsetting.js" asp-append-version="true"></script>
}
