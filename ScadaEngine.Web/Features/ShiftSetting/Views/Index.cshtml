@model ScadaEngine.Web.Features.ShiftSetting.Models.ShiftSettingViewModel
@{
    ViewData["Title"] = Localizer["shiftsetting.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="fas fa-user-clock text-primary me-2"></i>@Localizer["shiftsetting.title"]
        </h2>
        <span class="text-muted small">
            <i class="fas fa-leaf me-1"></i>@Localizer["shiftsetting.breadcrumb.energy"]
        </span>
    </div>

    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2 d-flex justify-content-between align-items-center">
            <span><i class="fas fa-list me-1"></i>@Localizer["shiftsetting.card.title"]</span>
            <div class="d-flex gap-2">
                <button class="btn btn-outline-primary btn-sm" onclick="window._ss.add()">
                    <i class="fas fa-plus me-1"></i>@Localizer["shiftsetting.button.add"]
                </button>
                <button class="btn btn-primary btn-sm" onclick="window._ss.save()" id="ssBtnSave">
                    <i class="fas fa-save me-1"></i>@Localizer["shiftsetting.button.save"]
                </button>
            </div>
        </div>
        <div class="card-body p-3">
            <div id="ssAlert" class="d-none alert py-2 mb-2" role="alert"></div>
            <div class="table-responsive">
                <table class="table table-bordered align-middle mb-0 ss-table">
                    <thead class="table-light">
                        <tr>
                            <th class="ss-col-name">@Localizer["shiftsetting.col.name"]</th>
                            <th class="ss-col-hour">@Localizer["shiftsetting.col.start"]</th>
                            <th class="ss-col-hour">@Localizer["shiftsetting.col.end"]</th>
                            <th class="ss-col-duration">@Localizer["shiftsetting.col.duration"]</th>
                            <th>@Localizer["shiftsetting.col.weekdays"]</th>
                            <th class="ss-col-action"></th>
                        </tr>
                    </thead>
                    <tbody id="ssBody">
                        <tr><td colspan="6" class="text-center text-muted py-4">@Localizer["shiftsetting.loading"]</td></tr>
                    </tbody>
                </table>
            </div>
        </div>
        <div class="card-footer bg-light text-muted small">
            <i class="fas fa-info-circle me-1"></i>@Localizer["shiftsetting.hint"]
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/shiftsetting.css" />

@section Scripts {
    <script src="~/js/shiftsetting.js"></script>
}
