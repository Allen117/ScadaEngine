@model ScadaEngine.Web.Features.WaterCostReport.Models.WaterCostReportViewModel
@{
    ViewData["Title"] = Localizer["watercostreport.title"].Value;
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container-fluid mt-2">
    <div class="d-flex justify-content-between align-items-center mb-2">
        <h2 class="mb-0">
            <i class="fas fa-hand-holding-water text-primary me-2"></i>@Localizer["watercostreport.title"]
        </h2>
        <span class="text-muted small">
            <i class="fas fa-leaf me-1"></i>@Localizer["watercostreport.breadcrumb.energy"]
        </span>
    </div>

    <!-- 查詢條件（版型同電費報表，樣式共用 energyreport.css 的 er-* class） -->
    <div class="card shadow-sm mb-3">
        <div class="card-header bg-light py-2">
            <i class="fas fa-filter me-1"></i>@Localizer["watercostreport.filter.title"]
        </div>
        <div class="card-body p-3">
            <div class="er-filter-bar">
                <div class="er-circuit">
                    <label class="form-label fw-semibold"><i class="fas fa-sitemap me-1"></i>@Localizer["watercostreport.filter.circuit"]</label>
                    <select id="wcrCircuit" class="form-select form-select-sm">
                        <option value="">@Localizer["watercostreport.select.loading"]</option>
                    </select>
                </div>
                <div class="er-narrow-date">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["watercostreport.filter.month_start"]</label>
                    <input type="month" id="wcrMonthStart" class="form-control form-control-sm">
                </div>
                <div class="er-narrow-date">
                    <label class="form-label fw-semibold"><i class="fas fa-calendar-week me-1"></i>@Localizer["watercostreport.filter.month_end"]</label>
                    <input type="month" id="wcrMonthEnd" class="form-control form-control-sm">
                </div>
                <div class="er-period-hint">
                    <span id="wcrPeriodHint" class="text-muted small"></span>
                </div>
                <div class="er-btn">
                    <button class="btn btn-primary btn-sm" onclick="window._wcr.query()">
                        <i class="fas fa-search me-1"></i>@Localizer["watercostreport.button.query"]
                    </button>
                </div>
                <div class="er-btn">
                    <button class="btn btn-success btn-sm" onclick="window._wcr.exportExcel()" id="btnWcrExport" disabled>
                        <i class="fas fa-file-excel me-1"></i>@Localizer["watercostreport.button.export"]
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- 結果區 -->
    <div class="row g-3">
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-chart-bar me-1"></i>@Localizer["watercostreport.chart.title"]
                </div>
                <div class="card-body">
                    <div style="height:360px;position:relative;">
                        <canvas id="wcrChart"></canvas>
                        <div id="wcrNoData" class="wcr-nodata" style="display:none;"></div>
                    </div>
                </div>
                <div class="card-footer bg-light text-muted small">
                    @Localizer["watercostreport.label.total"]：<span id="wcrTotalCost" class="fw-bold text-primary">--</span> @Localizer["watercostreport.unit.ntd"]
                    <span class="ms-3">@Localizer["watercostreport.label.total_m3"]：<span id="wcrTotalM3" class="fw-bold">--</span> m&#179;</span>
                </div>
            </div>
        </div>
        <div class="col-lg-6">
            <div class="card shadow-sm">
                <div class="card-header bg-light py-2">
                    <i class="fas fa-table me-1"></i>@Localizer["watercostreport.table.title"]
                </div>
                <div class="card-body p-0">
                    <div class="table-responsive" style="max-height:420px;overflow-y:auto;">
                        <table class="table table-striped table-hover table-bordered mb-0">
                            <thead class="table-dark" style="position:sticky;top:0;z-index:30;">
                                <tr>
                                    <th>@Localizer["watercostreport.table.col_period"]</th>
                                    <th class="text-end">@Localizer["watercostreport.table.col_m3"]</th>
                                    <th>@Localizer["watercostreport.table.col_plan"]</th>
                                    <th class="text-end">@Localizer["watercostreport.table.col_cost"]</th>
                                    <th class="text-center">@Localizer["watercostreport.table.col_detail"]</th>
                                </tr>
                            </thead>
                            <tbody id="wcrTableBody">
                                <tr><td colspan="5" class="text-center text-muted py-4">@Localizer["watercostreport.table.empty"]</td></tr>
                            </tbody>
                        </table>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<link rel="stylesheet" href="~/css/energyreport.css" />
<link rel="stylesheet" href="~/css/watercostreport.css" asp-append-version="true" />

@section Scripts {
    <script src="~/lib/chartjs/chart.umd.min.js"></script>
    <script src="~/js/watercostreport.js" asp-append-version="true"></script>
    <script>
        window._wcrInit = { today: '@Model.dtToday.ToString("yyyy-MM-dd")' };
    </script>
}
